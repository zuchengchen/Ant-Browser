{
  "manifest_version": 3,
  "minimum_chrome_version": "106",
  "name": "导入到 MOFA",
  "version": "1.0.9",
  "description": "在当前 Ant 实例中核对 ChatGPT 账号并导入 MOFA。",
  "icons": { "32": "icon-32.png", "48": "icon-48.png" },
  "action": {
    "default_title": "导入到 MOFA",
    "default_icon": { "32": "icon-32.png" }
  },
  "background": { "service_worker": "toolbar-v1-0-9.js", "type": "module" },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "incognito": "not_allowed"
}
