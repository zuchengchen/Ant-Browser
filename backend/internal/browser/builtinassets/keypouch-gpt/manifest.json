{
  "manifest_version": 3,
  "minimum_chrome_version": "106",
  "name": "登录 GPT",
  "version": "1.3.5",
  "description": "使用当前 Ant 实例同步或授权的账号登录 ChatGPT。",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png" },
  "action": {
    "default_title": "登录 GPT",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  },
  "background": { "service_worker": "toolbar.js" },
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://chatgpt.com/*", "https://auth.openai.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
